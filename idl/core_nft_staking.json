  "types": [
    {
      "name": "Oracle",
      "docs": [
        "Static (PDA) Oracle account read by MPL Core on every `Transfer` of an",
        "asset in the collection.",
        "",
        "NOTE: `validation` MUST stay the first field."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "validation",
            "type": {
              "defined": {
                "name": "OracleValidation"
              }
            }
          },
          {
            "name": "crank_reward",
            "docs": [
              "Lamports paid out of the vault to whoever cranks at the right time."
            ],
            "type": "u64"
          },
          {
            "name": "crank_window",
            "docs": [
              "A crank is only paid if it lands within this many seconds after a",
              "window boundary (open / close)."
            ],
            "type": "i64"
          },
          {
            "name": "last_updated",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "vault_bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "OracleResult",
      "docs": [
        "Mirrors `mpl_core::types::ExternalValidationResult` (same Borsh layout)."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Approved"
          },
          {
            "name": "Rejected"
          },
          {
            "name": "Pass"
          }
        ]
      }
    },
    {
      "name": "OracleValidation",
      "docs": [
        "Mirrors `mpl_core::types::OracleValidation` (same Borsh layout). MPL Core",
        "reads this straight out of our account data, right after the 8 byte Anchor",
        "discriminator (`ValidationResultsOffset::Anchor`)."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Uninitialized"
          },
          {
            "name": "V1",
            "fields": [
              {
                "name": "create",
                "type": {
                  "defined": {
                    "name": "OracleResult"
                  }
                }
              },
              {
                "name": "transfer",
                "type": {
                  "defined": {
                    "name": "OracleResult"
                  }
                }
              },
              {
                "name": "burn",
                "type": {
                  "defined": {
                    "name": "OracleResult"
                  }
                }
              },
              {
                "name": "update",
                "type": {
                  "defined": {
                    "name": "OracleResult"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "StakeAccount",
      "docs": [
        "Per-asset stake record. This PDA is also the *plugin authority* of the",
        "asset's `FreezeDelegate` and `BurnDelegate` plugins, so the program (and only",
        "the program) can thaw / burn the asset."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "asset",
            "type": "pubkey"
          },
          {
            "name": "staked_at",
            "type": "i64"
          },
          {
            "name": "last_claim_at",
            "docs": [
              "Rewards accrue from here; moved forward by `claim_rewards`."
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "StakeConfig",
      "docs": [
        "One staking pool, bound to exactly one MPL Core collection."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "docs": [
              "Collection admin: creates the pool and the oracle."
            ],
            "type": "pubkey"
          },
          {
            "name": "collection",
            "docs": [
              "The MPL Core collection whose assets can be staked."
            ],
            "type": "pubkey"
          },
          {
            "name": "reward_per_second",
            "docs": [
              "Reward tokens (base units) accrued per staked NFT per second."
            ],
            "type": "u64"
          },
          {
            "name": "burn_bonus",
            "docs": [
              "One-time reward tokens (base units) paid on top of accrued rewards when",
              "a staked NFT is burned."
            ],
            "type": "u64"
          },
          {
            "name": "freeze_period",
            "docs": [
              "Seconds an NFT has to stay staked before it can be unstaked."
            ],
            "type": "i64"
          },
          {
            "name": "max_stake",
            "docs": [
              "Max NFTs a single user may stake at once."
            ],
            "type": "u8"
          },
          {
            "name": "rewards_bump",
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
